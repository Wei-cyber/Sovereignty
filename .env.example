# Copy to .env and configure your server API key before startup.
APP_ENV=development
DATABASE_URL=sqlite:///./data/workspace.db
JOB_MODE=local
MODEL_PROVIDER=openai
CHAT_MODEL=gpt-5.6
GRADER_MODEL=gpt-5.6-terra
ANSWER_REASONING_EFFORT=low
AGENT_REASONING_EFFORT=medium
GRADER_REASONING_EFFORT=medium
MODEL_MAX_OUTPUT_TOKENS=4096
PROVIDER_TIMEOUT_SECONDS=45
# Embeddings run locally using the pinned BGE artifact.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
# For native Python only; Docker images have their own baked-in model directory.
EMBEDDING_MODEL_DIR=./data/models/bge-small-en-v1.5
OPENAI_API_KEY=
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./data
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Used only on first bootstrap. No default production password.
BOOTSTRAP_EMAIL=admin@example.test
BOOTSTRAP_PASSWORD=
# Required for live publication; generate from reviewed human grader labels.
GRADER_CALIBRATION_FILE=
MAX_JOB_ATTEMPTS=3
TRACE_RETENTION_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
CONNECTION_ENCRYPTION_KEY=
MCP_SIGNING_KEY=
SEARXNG_URL=http://search:8080
# Optional: old demo password to retire during migration; leave blank for new installs.
RETIRED_DEMO_PASSWORD=
