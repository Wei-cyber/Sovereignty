{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "relay-setup-v4",
        "namespace": "relay"
      },
      "spec": {
        "backoffLimit": 2,
        "activeDeadlineSeconds": 600,
        "template": {
          "metadata": {
            "labels": {
              "app": "relay",
              "component": "setup"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 90,
            "containers": [
              {
                "name": "bootstrap",
                "image": "relay-workspace-backend:k8s-v4.2",
                "imagePullPolicy": "IfNotPresent",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "command": [
                  "python",
                  "-m",
                  "backend.manage",
                  "bootstrap"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "relay-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "relay-integrations"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "relay-database",
                        "key": "application-url"
                      }
                    }
                  },
                  {
                    "name": "BOOTSTRAP_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "relay-live-bootstrap",
                        "key": "bootstrap-password"
                      }
                    }
                  },
                  {
                    "name": "OPENAI_API_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "relay-openai",
                        "key": "api-key"
                      }
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "documents",
                    "mountPath": "/data"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "documents",
                "persistentVolumeClaim": {
                  "claimName": "relay-documents"
                }
              }
            ],
            "restartPolicy": "Never",
            "initContainers": [
              {
                "name": "migrate",
                "image": "relay-workspace-backend:k8s-v4.2",
                "imagePullPolicy": "IfNotPresent",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "command": [
                  "python",
                  "-m",
                  "backend.manage",
                  "migrate"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "relay-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "relay-integrations"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "relay-database",
                        "key": "migration-url"
                      }
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "documents",
                    "mountPath": "/data"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
