RELAY_ENV_FILE=.env.compose
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
POSTGRES_APP_PASSWORD=replace-with-a-different-url-safe-password
APP_ENV=development
MODEL_PROVIDER=openai
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
BOOTSTRAP_EMAIL=admin@example.test
BOOTSTRAP_PASSWORD=replace-with-a-strong-bootstrap-password
CHAT_MODEL=gpt-5.6
GRADER_MODEL=gpt-5.6-terra
ANSWER_REASONING_EFFORT=low
AGENT_REASONING_EFFORT=medium
GRADER_REASONING_EFFORT=medium
MODEL_MAX_OUTPUT_TOKENS=4096
PROVIDER_TIMEOUT_SECONDS=45
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL_DIR=/app/models/bge-small-en-v1.5
OPENAI_API_KEY=
GRADER_CALIBRATION_FILE=
MAX_JOB_ATTEMPTS=3
TRACE_RETENTION_DAYS=30
WEB_PORT=8080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
CONNECTION_ENCRYPTION_KEY=
MCP_SIGNING_KEY=
SEARXNG_SECRET=
SEARXNG_URL=http://search:8080
# Optional: old demo password to retire during migration; leave blank for new installs.
RETIRED_DEMO_PASSWORD=
